    "url": "https://github.com/Ramestta-Blockchain/ramestta-bridge-sdk/issues"
  },
  "dependencies": {
    "@ramestta/contracts": "^1.1.1",
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
